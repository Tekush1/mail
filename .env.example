# ============================================
# BULK MAILING SYSTEM — Environment Config
# ============================================

# Supabase (Frontend client - safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase (Backend/server - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App Password Login
APP_PASSWORD=your_secure_password_here

# Resend SMTP (Account 1 - 300 emails)
RESEND_API_KEY_1=re_xxxxxxxxxxxxxxxxxxxx

# Resend SMTP (Account 2 - next 300 emails)
RESEND_API_KEY_2=re_yyyyyyyyyyyyyyyyyyyy

# Resend Sender Email (must be verified in Resend dashboard)
RESEND_SENDER_EMAIL=you@yourdomain.com
RESEND_SENDER_NAME=Your Name

# Brevo SMTP (Account 1 - fallback)
BREVO_SMTP_USER_1=your@email.com
BREVO_SMTP_KEY_1=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx

# Brevo SMTP (Account 2 - fallback)
BREVO_SMTP_USER_2=other@email.com
BREVO_SMTP_KEY_2=xsmtpsib-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy-yyyyyyyyyyyyyyyy
